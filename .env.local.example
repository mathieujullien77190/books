# Copie ce fichier en .env.local et renseigne ta vraie chaîne de connexion Atlas (jamais dans le chat,
# jamais commité). .env.local est déjà ignoré par git.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bibliotheque

# Code qui déverrouille l'Édition (obligatoire pour modifier quoi que ce soit) et clé de signature du jeton.
EDIT_CODE=
EDIT_SECRET=
